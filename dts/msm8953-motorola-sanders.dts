// SPDX-License-Identifier: BSD-3-Clause
/*
 * Motorola Moto G5s Plus (sanders) — proof-of-life DTS.
 * Derivado de msm8953-motorola-potter.dts (Moto G5 Plus). Hardware base
 * idêntico (msm8953 + pm8953 + pmi8950, display 1080x1920, MMC, USB, touch
 * Synaptics RMI4). Painel pode diferir (Tianma NT35596 ou DJN ILI7807D no
 * sanders); por enquanto reaproveitamos só o cont_splash_mem do bootloader.
 */
/dts-v1/;

#include "msm8953.dtsi"
#include "pm8953.dtsi"
#include "pmi8950.dtsi"

/delete-node/ &cont_splash_mem;
/delete-node/ &qseecom_mem;

/ {
	model = "Motorola Moto G5s Plus";
	compatible = "motorola,sanders", "qcom,msm8953";
	chassis-type = "handset";
	qcom,msm-id = <293 0>;
	/* Cobre todas as 6 variantes do sanders no fork lk2nd:
	 * p1, p2, p3-1, p3-2, p4-1, p4-2. lk2nd casa contra
	 * lk2nd_dt_override e seleciona automaticamente. */
	qcom,board-id = <0x4B 0x8100>,
			<0x4B 0x8200>,
			<0x4B 0x8300>,
			<0x4B 0x83B0>,
			<0x4B 0x8400>,
			<0x4C 0x8400>;

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		framebuffer@90001000 {
			compatible = "simple-framebuffer";
			reg = <0 0x90001000 0 (2220 * 1920 * 3)>;

			width = <1080>;
			height = <1920>;
			stride = <(1080 * 3)>;
			format = "r8g8b8";

			power-domains = <&gcc MDSS_GDSC>;

			clocks = <&gcc GCC_MDSS_AHB_CLK>,
				 <&gcc GCC_MDSS_AXI_CLK>,
				 <&gcc GCC_MDSS_VSYNC_CLK>,
				 <&gcc GCC_MDSS_MDP_CLK>,
				 <&gcc GCC_MDSS_BYTE0_CLK>,
				 <&gcc GCC_MDSS_PCLK0_CLK>,
				 <&gcc GCC_MDSS_ESC0_CLK>;
		};
	};

	gpio-keys {
		compatible = "gpio-keys";

		pinctrl-names = "default";
		pinctrl-0 = <&gpio_key_default>;

		key-volume-up {
			label = "Volume Up";
			gpios = <&tlmm 85 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_VOLUMEUP>;
		};
	};

	/*
	 * LED de notificacao frontal — branco unico, ligado no MPP2 do
	 * pmi8950 como current-sink. Downstream Moto (qpnp-leds) usava modo
	 * "manual" com source-sel=1 e current=5mA. No mainline atual nao ha
	 * driver MPP-as-current-sink; usamos leds-gpio (on/off apenas).
	 * Brilho/PWM via pmi8950_pwm fica como upgrade futuro.
	 */
	leds {
		compatible = "gpio-leds";

		led-notification {
			label = "white:notification";
			gpios = <&pmi8950_mpps 1 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
	};

	reserved-memory {
		qseecom_mem: qseecom@84300000 {
			reg = <0x0 0x84300000 0x0 0x2000000>;
			no-map;
		};

		cont_splash_mem: cont-splash@90001000 {
			reg = <0x0 0x90001000 0x0 (1080 * 1920 * 3)>;
			no-map;
		};

		reserved@aefd2000 {
			reg = <0x0 0xaefd2000 0x0 0x2e000>;
			no-map;
		};

		reserved@eefe4000 {
			reg = <0x0 0xeefe4000 0x0 0x1c000>;
			no-map;
		};

		ramoops@ef000000 {
			compatible = "ramoops";
			reg = <0x0 0xef000000 0x0 0x80000>;
			console-size = <0x40000>;
			ftrace-size = <0>;
			record-size = <0x3f800>;
			pmsg-size = <0x800>;
		};
	};

	vph_pwr: vph-pwr-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vph_pwr";
		regulator-always-on;
		regulator-boot-on;
	};

	/*
	 * cpufreq NAO wireado de proposito: msm8953 nao tem driver de
	 * clock-controller de CPU (APCS) no mainline (drivers/clk/qcom/
	 * so cobre apcs-msm8916.c e apcs-msm8996.c, nao 8953/8976). O
	 * clock real do Cortex-A53 nao e exposto ao Linux ainda.
	 *
	 * Tentativa anterior amarrou &cpuN a GCC_APSS_AHB_CLK (barramento
	 * AHB da APSS, nao o core clock) com OPPs de 652MHz-2.016GHz —
	 * tecnicamente errado: esse clock tem teto de 133.33MHz
	 * (ftbl_apss_ahb_clk_src em drivers/clk/qcom/gcc-msm8953.c),
	 * ~15x abaixo do topo da tabela. cpufreq-dt bindaria mas
	 * clk_set_rate() saturaria/falharia, e escalar esse clock por
	 * engano afeta o barramento de registrador de outros perifericos.
	 * Revertido em 2026-09-02. Fix real exige escrever/portar um
	 * driver APCS pro msm8953 — trabalho de bring-up de SoC, nao
	 * fragmento de devicetree.
	 */
};

&hsusb_phy {
	vdd-supply = <&pm8953_l3>;
	vdda-pll-supply = <&pm8953_l7>;
	vdda-phy-dpdm-supply = <&pm8953_l13>;

	status = "okay";
};

&i2c_3 {
	status = "okay";
	clock-frequency = <400000>;	/* stock Android usa 400kHz no FT5436 */

	/* Forca PIO (sem DMA) — o controller mainline pode estar com
	 * bug DMA em transactions especificas do FT5436. */
	/delete-property/ dmas;
	/delete-property/ dma-names;

	/* Moto G5s Plus stock Android usa Focaltech FT5436 @ 0x38 com
	 * VDD em pm8953_l10 (2.85V, always-on) e VCC_I2C em pm8953_l5
	 * (1.8V). Reset GPIO 64, IRQ GPIO 65. (Nao Synaptics RMI4 como
	 * o irmao potter.) */
	touchscreen@38 {
		reg = <0x38>;
		compatible = "focaltech,ft5426";

		interrupt-parent = <&tlmm>;
		interrupts = <65 IRQ_TYPE_EDGE_FALLING>;

		/* Reset GPIO controlado via gpio-hog (sempre HIGH) — o pulse
		 * curto do driver (~5ms) estava deixando o chip num estado
		 * de boot e o regmap_bulk_read dava -ETIMEDOUT. */

		vcc-supply = <&pm8953_l10>;
		iovcc-supply = <&pm8953_l5>;

		touchscreen-size-x = <1080>;
		touchscreen-size-y = <1920>;
	};
};

/*
 * Sensor de proximidade + luz ambiente: LiteON LTR559 no i2c_7 @ 0x23.
 *
 * Stock Android (msm8953-sanders.dtsi):
 *   liteon@23 {
 *     compatible = "liteon,ltr559";
 *     vdd-supply = <&pm8953_l10>;       // 2.85V (mesmo do FT5436)
 *     vio-supply = <&pm8953_l6>;        // 1.8V always-on
 *     interrupts = <86 IRQ_TYPE_EDGE_FALLING>;
 *     ltr,ps-threshold = <800>;         // params calibrados pela Moto;
 *     ltr,ps-nearoffset = <20>;         // mainline ltr501 driver usa
 *     ltr,ps-faroffset = <15>;          // proximity-near-level (75).
 *   }
 *
 * Driver mainline: drivers/iio/light/ltr501.c (cobre ltr501/559/301).
 * Expoe via IIO: in_illuminance_raw, in_proximity_raw, eventos em
 * /dev/iio:device*. Phosh/iio-sensor-proxy consomem direto.
 *
 * Acel/giro/magnetom NAO estao em I2C — passam pela SSC (Sensor
 * Subsystem) no SLPI/DSP, caminho proprietario sem driver mainline
 * pratico hoje.
 */
&i2c_7 {
	status = "okay";
	clock-frequency = <400000>;

	light-sensor@23 {
		compatible = "liteon,ltr559";
		reg = <0x23>;

		vdd-supply = <&pm8953_l10>;
		vddio-supply = <&pm8953_l6>;

		interrupt-parent = <&tlmm>;
		interrupts = <86 IRQ_TYPE_EDGE_FALLING>;

		proximity-near-level = <75>;
	};
};

&pm8953_resin {
	linux,code = <KEY_VOLUMEDOWN>;
	status = "okay";
};

&pmi8950_wled {
	qcom,current-limit-microamp = <25000>;
	qcom,num-strings = <3>;
	qcom,external-pfet;
	qcom,cabc;

	status = "okay";
};

&rpm_requests {
	regulators {
		compatible = "qcom,rpm-pm8953-regulators";
		vdd_s1-supply = <&vph_pwr>;
		vdd_s2-supply = <&vph_pwr>;
		vdd_s3-supply = <&vph_pwr>;
		vdd_s4-supply = <&vph_pwr>;
		vdd_s5-supply = <&vph_pwr>;
		vdd_s6-supply = <&vph_pwr>;
		vdd_s7-supply = <&vph_pwr>;
		vdd_l1-supply = <&pm8953_s3>;
		vdd_l2_l3-supply = <&pm8953_s3>;
		vdd_l4_l5_l6_l7_l16_l19-supply = <&pm8953_s4>;
		vdd_l8_l11_l12_l13_l14_l15-supply = <&vph_pwr>;
		vdd_l9_l10_l17_l18_l22-supply = <&vph_pwr>;

		pm8953_s1: s1 {
			regulator-min-microvolt = <863000>;
			regulator-max-microvolt = <1152000>;
		};

		pm8953_s3: s3 {
			regulator-min-microvolt = <1224000>;
			regulator-max-microvolt = <1224000>;
		};

		pm8953_s4: s4 {
			regulator-min-microvolt = <1896000>;
			regulator-max-microvolt = <2048000>;
		};

		pm8953_l1: l1 {
			regulator-min-microvolt = <1000000>;
			regulator-max-microvolt = <1100000>;
		};

		pm8953_l2: l2 {
			regulator-min-microvolt = <1000000>;
			regulator-max-microvolt = <1000000>;
		};

		pm8953_l3: l3 {
			regulator-min-microvolt = <925000>;
			regulator-max-microvolt = <925000>;
			regulator-allow-set-load;
		};

		pm8953_l5: l5 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
		};

		pm8953_l6: l6 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			regulator-always-on;
		};

		pm8953_l7: l7 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1900000>;
		};

		pm8953_l8: l8 {
			regulator-min-microvolt = <2900000>;
			regulator-max-microvolt = <2900000>;
		};

		pm8953_l9: l9 {
			regulator-min-microvolt = <3000000>;
			regulator-max-microvolt = <3300000>;
		};

		pm8953_l10: l10 {
			/* Touchscreen FT5436 VDD (2.85V). Stock Android tem
			 * always-on para manter o chip alimentado sempre. */
			regulator-min-microvolt = <2850000>;
			regulator-max-microvolt = <2850000>;
			regulator-always-on;
		};

		pm8953_l11: l11 {
			regulator-min-microvolt = <2800000>;
			regulator-max-microvolt = <3000000>;
		};

		pm8953_l12: l12 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <3000000>;
		};

		pm8953_l13: l13 {
			regulator-min-microvolt = <3075000>;
			regulator-max-microvolt = <3125000>;
		};

		pm8953_l15: l15 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
		};

		pm8953_l16: l16 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
		};

		pm8953_l17: l17 {
			regulator-min-microvolt = <2800000>;
			regulator-max-microvolt = <3000000>;
		};

		pm8953_l19: l19 {
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1350000>;
		};

		pm8953_l22: l22 {
			regulator-always-on;
			regulator-min-microvolt = <2800000>;
			regulator-max-microvolt = <2850000>;
		};

		pm8953_l23: l23 {
			regulator-min-microvolt = <975000>;
			regulator-max-microvolt = <1225000>;
		};
	};
};

&sdhc_1 {
	vmmc-supply = <&pm8953_l8>;
	vqmmc-supply = <&pm8953_l5>;

	status = "okay";
};

&sdhc_2 {
	vmmc-supply = <&pm8953_l11>;
	vqmmc-supply = <&pm8953_l12>;

	cd-gpios = <&tlmm 133 GPIO_ACTIVE_LOW>;

	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&sdc2_clk_on &sdc2_cmd_on &sdc2_data_on &sdc2_cd_off>;
	pinctrl-1 = <&sdc2_clk_off &sdc2_cmd_off &sdc2_data_off &sdc2_cd_off>;

	status = "okay";
};

&tlmm {
	gpio-reserved-ranges = <1 2>, <96 4>, <111 1>, <126 1>;

	/* Mantem o touchscreen FT5436 sempre fora de reset. */
	ts-reset-hog {
		gpio-hog;
		gpios = <64 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "touchscreen-reset";
	};

	ts_reset: ts-reset-state {
		pins = "gpio64";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
		output-high;
	};
};

&usb3 {
	status = "okay";
};

&usb3_dwc3 {
	/delete-property/ usb-role-switch;
	dr_mode = "peripheral";
};

/*
 * Wi-Fi/Bluetooth (WCN3680B "pronto" + iris RF transceiver).
 *
 * Reguladores extraidos do DTB stock Android (qcom,wcnss-wlan):
 *   - vddxo  -> pm8953_l7  (1.8V)
 *   - vddrfa -> pm8953_l19 (1.2V)
 *   - vddpa  -> pm8953_l9  (3.0V)
 *   - vdddig -> pm8953_l5  (1.8V)
 *   - vddpx  -> pm8953_l5  (1.8V)
 *   - vddcx/vddmx ja vem via power-domains do msm8953.dtsi
 *
 * Firmware necessario em /lib/firmware/wlan/prima/ (extraido do
 * Android stock NON-HLOS.bin).
 */
&wcnss {
	vddpx-supply = <&pm8953_l5>;

	status = "okay";
};

&wcnss_iris {
	compatible = "qcom,wcn3680";

	vddxo-supply = <&pm8953_l7>;
	vddrfa-supply = <&pm8953_l19>;
	vddpa-supply = <&pm8953_l9>;
	vdddig-supply = <&pm8953_l5>;
};

&soc {
	watchdog@b017000 {
		compatible = "qcom,kpss-wdt";
		reg = <0x0b017000 0x1000>;
		clocks = <&sleep_clk>;
		status = "okay";
	};
};


