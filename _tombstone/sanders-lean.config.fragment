# ARQUIVADO (2026-09-14): ver _tombstone/README.md — experimento
# abandonado, aparelho revertido pro kernel completo.
#
# Config fragment "enxuto" (headless-only) pro Moto G5s Plus / G5 Plus —
# deriva de sanders.config.fragment removendo tudo que so serve pros
# flavors graficos (display, audio, touchscreen, sensores, LED). Uso
# pretendido: flavors sem sessao grafica ("minimal", "server",
# "server-docker" — ver docs/FLAVORS.md). NAO use este fragment se quiser
# rodar xorg/xfce/weston-minimal depois: eles precisam do DRM_MSM e
# ficariam sem tela nenhuma com este kernel.
#
# Build separado, nao substitui o kernel "completo" atual — ver
# scripts/build-kernel-lean.sh (usa $BUILD isolado em build-lean/,
# repositorio do kernel clonado de novo ali, .config proprio; o
# build/ principal deste workspace fica intocado).
#
# Uso (feito pelo script acima, documentado aqui so por completude):
#   make ARCH=arm64 defconfig
#   ./scripts/kconfig/merge_config.sh -m .config kernel/sanders-lean.config.fragment
#   make ARCH=arm64 olddefconfig
#
# O que foi removido em relacao a sanders.config.fragment (ver esse
# arquivo pros comentarios originais e pras gotchas de cada bloco —
# aqui so listamos o que caiu, nao repetimos os porques de kernel-config
# que nao mudaram):
#   - Framebuffer/console grafico (CONFIG_FB*, LOGO*, FONTS*, FONT_TER16x32)
#     — debug via serial (ttyGS0/ttyMSM0, ja no KERNEL_CMDLINE em lib.sh)
#     cobre o caso headless; sem tela fisica conectada nao ha o que mostrar.
#   - DRM completo (DRM, DRM_SIMPLEDRM, DRM_FBDEV_*, DRM_MSM e toda a
#     cascata MDP5/DSI/DPU/GPU Adreno + zap shader, BACKLIGHT_*,
#     REGULATOR_QCOM_LABIBB, painéis Tianma/BOE, QCOM_OCMEM/LLCC/MDT_LOADER).
#   - Audio completo (SOUND/SND/SND_SOC* + toda a cascata QDSP6/WCD PM8916/PM8953).
#   - Touchscreen: Focaltech FT5436 (edt-ft5x06) e Synaptics RMI4.
#   - Sensor de proximidade/luz ambiente LTR501 + framework IIO.
#   - LED de notificacao (NEW_LEDS/LEDS_CLASS/LEDS_GPIO/LEDS_TRIGGER_*) —
#     alem de nao servir pra uso headless, o componente fisico foi
#     confirmado INEXISTENTE no XT1683 (ver
#     docs/archived/RELATORIO_INVESTIGACAO_LED_FRONTAL.md), entao nem faz
#     mais sentido builtin em kernel nenhum a partir de agora.
#   - CONFIG_INPUT_UINPUT (so serve pro AVRCP do player grafico via Bluetooth).
#
# O que fica (exatamente o que os flavors minimal/server/server-docker
# usam): rede (USB gadget ACM/ECM, USB host networking, Wi-Fi wcn36xx,
# Bluetooth btqcomsmd), netfilter/NAT/OverlayFS (Docker), zram/swap,
# watchdog, cpufreq scaffolding, power_supply (sysfs), Landlock (pacman).

# USB Gadget — CDC ACM como console serial via cabo USB.
# Builtin (=y), nao modulo (=m), pq o initramfs precisa criar o gadget
# antes do rootfs estar montado.
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_F_ACM=y
CONFIG_U_SERIAL_CONSOLE=y
# USB ethernet gadget (ECM) — rede sobre o mesmo cabo USB.
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_F_ECM=y
CONFIG_USB_U_ETHER=y

# Controlador USB DWC3 (Qualcomm glue + core)
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
# DWC3_HOST/GADGET/DUAL_ROLE sao uma "choice" (mutuamente exclusivos) —
# precisamos de DUAL_ROLE (host + gadget simultaneos). NAO marcar
# GADGET=y junto, senao ele vence a choice e DUAL_ROLE e descartado
# silenciosamente pelo olddefconfig.
CONFIG_USB_DWC3_DUAL_ROLE=y
# CONFIG_USB_DWC3_HOST is not set
# CONFIG_USB_DWC3_GADGET is not set

# PHY USB 2.0 do msm8953 (qusb2). Sem modprobe no initramfs, precisa
# builtin senao dwc3 fica deferred com "supplier 79000.phy not ready".
CONFIG_PHY_QCOM_QUSB2=y

# Landlock LSM (sandbox) — pacman usa em userspace pra isolar downloads.
# Sem isso, pacman -Sy falha com "Landlock is not supported by kernel".
CONFIG_SECURITY_LANDLOCK=y

# Wi-Fi (WCN3680B "pronto" + wcn36xx driver). Tudo builtin — cascata
# precisa ser TODA builtin senao o merge acaba forcando o leaf (wcn36xx)
# pra modulo (RFKILL=y e QCOM_PIL_INFO=y sao os dois pontos criticos).
CONFIG_RFKILL=y
CONFIG_RFKILL_INPUT=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH_COMMON=y
CONFIG_WCN36XX=y
CONFIG_WCN36XX_DEBUGFS=y
# Pronto remoteproc (PIL = Peripheral Image Loader)
CONFIG_REMOTEPROC=y
CONFIG_QCOM_PIL_INFO=y
CONFIG_QCOM_WCNSS_PIL=y
CONFIG_QCOM_WCNSS_CTRL=y
# IPC: smd (control channel) + smp2p (sinais inter-processador)
CONFIG_RPMSG_QCOM_SMD=y
CONFIG_QCOM_SMP2P=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SMEM_STATE=y
CONFIG_RPMSG=y
CONFIG_QCOM_SYSMON=y
CONFIG_RPMSG_QCOM_GLINK=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_QCOM_QMI_HELPERS=y
# QRTR: socket family AF_QIPCRTR usado pelo qmi handle do wcnss_pil.
CONFIG_QRTR=y
CONFIG_QRTR_SMD=y

# Bluetooth WCN3680B (mesmo chip do Wi-Fi, canal SMD ja exposto pelo wcnss).
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_LE_L2CAP_ECRED=y
CONFIG_BT_QCOMSMD=y
CONFIG_BT_QCA=y
CONFIG_BT_HIDP=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_BNEP=y

# PMIC Power-On (PON) — power-key e resin (volume down) no pm8953.
CONFIG_POWER_RESET_QCOM_PON=y

# Netfilter/NAT — necessario pro Docker (dockerd usa iptables-nft e
# precisa criar a chain NAT "DOCKER"). Sem isso: "iptables: Failed to
# initialize nft: Protocol not supported".
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_CT=y
CONFIG_NFT_CHAIN_NAT=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_FILTER=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_NAT=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_VETH=y
# xt_addrtype/xt_MASQUERADE — dockerd monta a chain "DOCKER" via
# `iptables -m addrtype --dst-type LOCAL -j DOCKER`.
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_TARGET_MARK=y
# NFT_COMPAT — traduz regras x_tables (addrtype, MASQUERADE, etc.) que o
# iptables-nft do Docker usa para nf_tables.
CONFIG_NFT_COMPAT=y

# OverlayFS — driver de storage padrao do Docker/containerd.
CONFIG_OVERLAY_FS=y

# CPU Frequency Scaling & Governors — scaffolding (nao ha driver de
# clock-controller de CPU/APCS do msm8953 no mainline ainda; ver
# docs/ROADMAP_AND_TODOS.md). Mantido por paridade com o fragment completo.
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPUFREQ_DT=y
CONFIG_ENERGY_MODEL=y

# Memory Swap & zram (compressao em RAM, otimizacao pro eMMC)
CONFIG_SWAP=y
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
CONFIG_ZBUD=y
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_ZSTD=y

# Qualcomm Hardware Watchdog & Auto-Recovery (qcom-wdt)
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
CONFIG_WATCHDOG_SYSFS=y
CONFIG_QCOM_WDT=y

# Power supply (sysfs) — sem driver mainline pro charger/fuel-gauge
# integrado (PMI8996) ainda; ver sanders.config.fragment/ROADMAP pro
# porque. Mantido so pelo que ja funciona via sysfs generico.
CONFIG_POWER_SUPPLY=y
CONFIG_POWER_SUPPLY_HWMON=y

# USB OTG Ethernet (host mode) — adaptadores USB-C/Ethernet quando o
# DWC3 troca pra host mode. Fallback de rede standalone alem do Wi-Fi.
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_NET_CDC_SUBSET=y
CONFIG_USB_NET_CDC_SUBSET_ENABLE=y
CONFIG_USB_RNDIS_HOST=y
