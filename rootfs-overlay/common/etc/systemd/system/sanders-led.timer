[Unit]
Description=Reavalia periodicamente o LED de status do servidor (sanders)

[Timer]
# Primeiro tick logo no boot (LED reflete o estado real, mesmo que "sem
# rede" ainda) e depois reavalia a cada 30s pra pegar rede subindo,
# caindo, etc. — sanders-led.service sozinho so roda uma vez (oneshot).
OnBootSec=10s
OnUnitActiveSec=30s
Unit=sanders-led.service

[Install]
WantedBy=timers.target
