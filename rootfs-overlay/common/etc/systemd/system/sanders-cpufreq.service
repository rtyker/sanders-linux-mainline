[Unit]
Description=Ajusta CPU Frequency Governor no Boot (schedutil)
# After=systemd-user-sessions.service, NAO multi-user.target: esta unit
# e WantedBy=multi-user.target, e "After=multi-user.target" + want do
# mesmo target = ciclo (multi-user teria que vir depois de si mesmo via
# want) — o systemd apagava o job deste servico em todo boot. Fix
# 2026-09-10 (BF) — ver docs/KNOWN_ISSUES_AND_POTENTIAL_BUGS.md BUG-013.
After=systemd-user-sessions.service
# msm8953 ainda nao tem cpufreq funcional no mainline (falta driver de
# clock-controller de CPU/APCS) — sem isso nao existe
# /sys/devices/system/cpu/cpu0/cpufreq/, e essa condition pula o
# servico de forma limpa (nao conta como falha/degraded) em vez de
# falhar todo boot. Remove esta linha quando cpufreq estiver funcional.
ConditionPathExists=/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor

[Service]
Type=oneshot
ExecStart=/usr/local/bin/sanders-cpufreq.sh schedutil
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
