[Unit]
Description=Set notification LED to server status (sanders)
# Nao depende de network-online.target de proposito: mesmo com o
# atraso de wait-online ja corrigido (ver override em
# systemd-networkd-wait-online.service.d/), continua sem sentido gatear
# um indicador de status LED na rede estar "pronta" — o script ja
# checa o estado atual da rede sozinho, entao rodar cedo so significa
# reportar "sem rede" corretamente ate a rede subir; o timer associado
# (sanders-led.timer) reavalia periodicamente e corrige o LED assim
# que usb0/wlan0/eth pegarem IP.
After=local-fs.target
ConditionPathExists=/sys/class/leds/white:notification

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/sanders-led.sh status
