From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Anderson <anderson@localhost>
Date: Fri, 4 Sep 2026 16:28:00 -0300
Subject: [PATCH] Input: synaptics-rmi4 - add F12 fallback for missing register
 descriptors and relax F01 unconfigured check

Some Synaptics touch ICs (such as S3603R on Moto G5 Plus potter) do not
expose register descriptors in F12 query registers, causing rmi_f12_probe
to fail with "Behavior of F12 without register descriptors is undefined".
Provide a hardcoded descriptor fallback (similar to upstream quirk series)
so that 2D multi-touch input is initialized properly.

Additionally, don't fail rmi_f01_probe if the status register still reports
unconfigured (0x81) during boot; log a warning instead.

Signed-off-by: Anderson <anderson@localhost>
---
 drivers/input/rmi4/rmi_f01.c |  7 ++--
 drivers/input/rmi4/rmi_f12.c | 66 +++++++++++++++++++++++++++++++++++-
 2 files changed, 68 insertions(+), 5 deletions(-)

diff --git a/drivers/input/rmi4/rmi_f01.c b/drivers/input/rmi4/rmi_f01.c
index 47be64284..be9623d04 100644
--- a/drivers/input/rmi4/rmi_f01.c
+++ b/drivers/input/rmi4/rmi_f01.c
@@ -560,10 +560,9 @@ static int rmi_f01_probe(struct rmi_function *fn)
 	}
 
 	if (RMI_F01_STATUS_UNCONFIGURED(device_status)) {
-		dev_err(&fn->dev,
-			"Device was reset during configuration process, status: %#02x!\n",
+		dev_warn(&fn->dev,
+			"Device status unconfigured (status: %#02x), continuing anyway\n",
 			RMI_F01_STATUS_CODE(device_status));
-		return -EINVAL;
 	}
 
 	dev_set_drvdata(&fn->dev, f01);
diff --git a/drivers/input/rmi4/rmi_f12.c b/drivers/input/rmi4/rmi_f12.c
index 88c28089d..de70f138d 100644
--- a/drivers/input/rmi4/rmi_f12.c
+++ b/drivers/input/rmi4/rmi_f12.c
@@ -369,6 +369,41 @@ static int rmi_f12_config(struct rmi_function *fn)
 	return 0;
 }
 
+static void rmi_f12_set_hardcoded_desc(struct rmi_function *fn, struct f12_data *f12)
+{
+	struct rmi_2d_sensor *sensor = &f12->sensor;
+	struct rmi_register_desc_item *reg_desc;
+
+	/* We have no f12->data_reg_desc, so the pkt_size is 0, override it with
+	 * a somewhat sensible default (this corresponds to 10 fingers).
+	 */
+	sensor->pkt_size = 88;
+
+	/*
+	 * There are no register descriptors to get these values from.
+	 * We set them to high values to either be overwritten by the clip
+	 * properties from devicetree, or to just not get in the way.
+	 */
+	sensor->max_x = 65535;
+	sensor->max_y = 65535;
+
+	/*
+	 * Create the Data1 register descriptor so that touch events
+	 * can work properly.
+	 */
+	reg_desc = devm_kcalloc(&fn->dev, 1,
+			sizeof(struct rmi_register_desc_item), GFP_KERNEL);
+	reg_desc->reg = 1;
+	reg_desc->reg_size = 80;
+	reg_desc->num_subpackets = 10;
+
+	f12->data1 = reg_desc;
+	f12->data1_offset = 0;
+	sensor->nbr_fingers = reg_desc->num_subpackets;
+	sensor->report_abs = 1;
+	sensor->attn_size += reg_desc->reg_size;
+}
+
 static int rmi_f12_probe(struct rmi_function *fn)
 {
 	struct f12_data *f12;
@@ -384,6 +419,7 @@ static int rmi_f12_probe(struct rmi_function *fn)
 	size_t pkt_size;
 	int irq_mask_size;
 	int i;
+	bool hardcoded_desc_quirk = false;
 
 	rmi_dbg(RMI_DEBUG_FN, &fn->dev, "%s\n", __func__);
 
@@ -398,9 +434,9 @@ static int rmi_f12_probe(struct rmi_function *fn)
 	++query_addr;
 
 	if (!(buf & BIT(0))) {
-		dev_err(&fn->dev,
-			"Behavior of F12 without register descriptors is undefined.\n");
-		return -ENODEV;
+		dev_info(&fn->dev,
+			"No register descriptors defined for F12, using fallback\n");
+		hardcoded_desc_quirk = true;
 	}
 
 	f12 = devm_kzalloc(&fn->dev, struct_size(f12, irq_mask, irq_mask_size * 2),
@@ -421,6 +457,29 @@ static int rmi_f12_probe(struct rmi_function *fn)
 		f12->sensor_pdata = pdata->sensor_pdata;
 	}
 
+	if (hardcoded_desc_quirk) {
+		rmi_f12_set_hardcoded_desc(fn, f12);
+
+		sensor = &f12->sensor;
+		sensor->fn = fn;
+		f12->data_addr = fn->fd.data_base_addr;
+		sensor->axis_align = f12->sensor_pdata.axis_align;
+		sensor->x_mm = f12->sensor_pdata.x_mm;
+		sensor->y_mm = f12->sensor_pdata.y_mm;
+		sensor->dribble = f12->sensor_pdata.dribble;
+
+		if (sensor->sensor_type == rmi_sensor_default)
+			sensor->sensor_type = f12->sensor_pdata.sensor_type;
+
+		sensor->data_pkt = devm_kmalloc(&fn->dev, sensor->pkt_size, GFP_KERNEL);
+		if (!sensor->data_pkt)
+			return -ENOMEM;
+
+		dev_set_drvdata(&fn->dev, f12);
+
+		goto skip_register_desc;
+	}
+
 	ret = rmi_f12_read_register_descs(fn, f12, query_addr);
 	if (ret)
 		return ret;
@@ -521,6 +580,7 @@ static int rmi_f12_probe(struct rmi_function *fn)
 		data_offset += item->reg_size;
 	}
 
+skip_register_desc:
 	/* allocate the in-kernel tracking buffers */
 	sensor->tracking_pos = devm_kcalloc(&fn->dev, sensor->nbr_fingers,
 					    sizeof(*sensor->tracking_pos),
-- 
