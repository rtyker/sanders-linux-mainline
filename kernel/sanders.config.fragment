# Config fragment para o port do Moto G5s Plus (sanders) em kernel mainline.
# Aplicado sobre arm64 defconfig.
#
# Uso:
#   make ARCH=arm64 defconfig
#   ./scripts/kconfig/merge_config.sh -m .config kernel/sanders.config.fragment
#   make ARCH=arm64 olddefconfig

# Framebuffer console (mostrar dmesg na tela do aparelho)
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER=y
CONFIG_LOGO=y
CONFIG_LOGO_LINUX_CLUT224=y

# DRM SimpleDRM — expoe o simple-framebuffer do bootloader como
# /dev/dri/card0 com um connector "Virtual-1". Necessario pra Wayland
# (weston, cage, sway) e GBM. Builtin pq nao temos modprobe no
# initramfs e o phone ainda nao tem driver de painel real
# (Tianma NT35596/DJN ILI7807D nao tem driver mainline).
# Renderer e software (pixman) — Adreno 506 (freedreno) ficaria
# ocioso ate termos painel DRM real.
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
# FBDEV emulado pelo DRM (mantem /dev/fb0 funcional pro fbcon do tty1).
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_FBDEV_OVERALLOC=100
# Fonte grande pra display 1080x1920 portrait (16x32 = ~60 colunas legiveis).
# Selecionada via cmdline `fbcon=font:TER16x32`.
CONFIG_FONTS=y
CONFIG_FONT_TER16x32=y

# USB Gadget — CDC ACM como console serial via cabo USB.
# Importante: builtin (=y), nao modulo (=m), pq o initramfs precisa criar
# o gadget antes do rootfs estar montado.
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_F_ACM=y
CONFIG_U_SERIAL_CONSOLE=y
# USB ethernet gadget (ECM) — pra ter rede sobre o mesmo cabo USB.
# Trocamos NCM por ECM: NCM agrega pacotes em superblocos, e o cdc_ncm
# no host estava perdendo bursts (host RX << phone TX). ECM eh 1:1 sem
# agregacao, mais estavel.
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_F_ECM=y
CONFIG_USB_U_ETHER=y

# Controlador USB DWC3 (Qualcomm glue + core)
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_DWC3_GADGET=y

# PHY USB 2.0 do msm8953 (qusb2). Defconfig deixa como modulo (=m), mas
# como nao temos modprobe no initramfs, ele nunca carrega -> dwc3 fica
# deferred com "supplier 79000.phy not ready". Forcar builtin.
CONFIG_PHY_QCOM_QUSB2=y

# Touchscreen Focaltech FT5436 (descoberto via DTB stock Android: i2c@78b7000
# addr 0x38, VDD=pm8953_l10, VCC_I2C=pm8953_l5). Driver mainline edt-ft5x06
# suporta variante ft5426 que e compativel com ft5436. Builtin para ter input
# disponivel desde o early boot.
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_EDT_FT5X06=y

# Landlock LSM (sandbox) — pacman usa em userspace pra isolar downloads.
# Sem isso, pacman -Sy falha com "Landlock is not supported by kernel".
CONFIG_SECURITY_LANDLOCK=y

# Wi-Fi (WCN3680B "pronto" + wcn36xx driver). Tudo builtin pra evitar
# probleminhas com firmware/module loading no boot. Firmware do pronto
# precisa estar em /lib/firmware/wlan/prima/ no rootfs (extraido do
# /vendor do stock e do /vendor/firmware/wlan/prima/WCNSS_cfg.dat do
# device — escrito de fabrica).
#
# Atencao: a cascata abaixo precisa ser TODA builtin senao o merge
# acaba forcando o leaf (wcn36xx) pra modulo. Em particular:
#   - RFKILL=y  (CFG80211 depende dele; se =m, CFG80211 vira =m)
#   - QCOM_PIL_INFO=y  (WCNSS_PIL depende; se =m, WCNSS_PIL vira =m)
CONFIG_RFKILL=y
CONFIG_RFKILL_INPUT=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH_COMMON=y
CONFIG_WCN36XX=y
# Pronto remoteproc (PIL = Peripheral Image Loader)
CONFIG_REMOTEPROC=y
CONFIG_QCOM_PIL_INFO=y
CONFIG_QCOM_WCNSS_PIL=y
CONFIG_QCOM_WCNSS_CTRL=y
# IPC: smd (control channel) + smp2p (sinais inter-processador)
CONFIG_RPMSG_QCOM_SMD=y
CONFIG_QCOM_SMP2P=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SMEM_STATE=y
# SMD-backed RPMSG character device — necessario pra wcnss_ctrl falar
# com o pronto via canal SMD WCNSS_CTRL
CONFIG_RPMSG=y
# QCOM_WCNSS_PIL tem "depends on FOO || FOO=n" pra varios componentes;
# se algum deles for =m, o PIL e capado para =m tambem. Por isso forcamos
# toda a cadeia builtin abaixo, senao a iface nao auto-sobe no boot
# (sem modprobe no initramfs).
CONFIG_QCOM_SYSMON=y
CONFIG_RPMSG_QCOM_GLINK=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_QCOM_QMI_HELPERS=y
# QRTR: socket family AF_QIPCRTR usado pelo qmi handle do wcnss_pil.
# Sem isso, init falha com "failed to initialize qmi handle" e a iface
# nao sobe.
CONFIG_QRTR=y
CONFIG_QRTR_SMD=y

# Bluetooth WCN3680B (mesmo chip do Wi-Fi). Driver mainline btqcomsmd
# usa o canal SMD ja exposto pelo wcnss — DT (`qcom,wcnss-bt`) ja vem
# pronto no msm8953.dtsi como subnode de wcnss/smd-edge/wcnss_ctrl.
# So precisa habilitar o subsistema BT + driver SMD.
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_LE_L2CAP_ECRED=y
CONFIG_BT_QCOMSMD=y
# selecionado por BT_QCOMSMD mas explicito por clareza
CONFIG_BT_QCA=y
# HIDP/RFCOMM uteis pra teclado/mouse/headset/SPP
CONFIG_BT_HIDP=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_BNEP=y

# Sensor de proximidade + luz ambiente LiteON LTR559 (i2c_7 @ 0x23).
# Driver mainline ltr501 cobre 501/559/301. Expoe via IIO. Builtin pq
# initramfs nao tem modprobe (e o Phosh consome via iio-sensor-proxy).
# Acel/giro NAO estao em i2c — passam pela SSC/DSP (sem mainline pratico).
CONFIG_IIO=y
CONFIG_LTR501=y
CONFIG_WCN36XX_DEBUG=y

# LED de notificacao frontal (MPP2 do pmi8950 via leds-gpio). Habilita
# tambem o sysfs trigger pra heartbeat/timer/disk-activity etc.
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
CONFIG_LEDS_TRIGGER_TIMER=y
CONFIG_LEDS_TRIGGER_DEFAULT_ON=y

# Netfilter/NAT — defconfig puro deixa NF_TABLES e NF_NAT desligados, o
# que quebra o Docker (dockerd usa iptables-nft por padrao e precisa criar
# a chain NAT "DOCKER"): "iptables: Failed to initialize nft: Protocol
# not supported". Confirmado ao vivo em 2026-09-02 (docker.service em
# crash loop). Sem isso nao ha bridge/NAT/port-publishing pra containers.
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_CT=y
CONFIG_NFT_CHAIN_NAT=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_FILTER=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_NAT=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_VETH=y

# CPU Frequency Scaling & Governors (cpufreq) — Kconfig scaffolding, ja
# vinha =y por default no defconfig; explicito aqui so por clareza.
# NAO resolve cpufreq sozinho: falta o driver de clock-controller de CPU
# (APCS) do msm8953 no mainline (nao existe drivers/clk/qcom/apcs-msm8953.c
# nem equivalente hoje). Sem isso o cpufreq-dt nao tem em que bindar —
# ver comentario em dts/msm8953-motorola-sanders.dts. Confirmado ao vivo
# 2026-09-02: /sys/devices/system/cpu/cpu0/cpufreq/ nao existe.
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPUFREQ_DT=y
CONFIG_ENERGY_MODEL=y

# Memory Swap & zram (Compressão em RAM para otimização do eMMC)
CONFIG_SWAP=y
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
CONFIG_ZBUD=y
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_ZSTD=y

# Qualcomm Hardware Watchdog & Auto-Recovery (qcom-wdt)
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
CONFIG_WATCHDOG_SYSFS=y
CONFIG_QCOM_WDT=y



